function home3dInitSheets() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var created = [], skipped = [];
  Object.keys(HOME3D_SHEETS).forEach(function (name) {
    if (ss.getSheetByName(name)) { skipped.push(name); return; }
    var rows = HOME3D_SHEETS[name];
    var sh = ss.insertSheet(name);
    sh.getRange(1, 1, rows.length, rows[0].length).setValues(rows.map(function (r) {
      while (r.length < rows[0].length) r.push('');
      return r;
    }));
    sh.getRange(1, 1, 1, rows[0].length).setFontWeight('bold').setBackground('#e8f0ff');
    sh.setFrozenRows(1);
    sh.autoResizeColumns(1, Math.min(rows[0].length, 12));
    created.push(name);
  });
  var msg = 'Создано: ' + (created.join(', ') || 'ничего') + (skipped.length ? '\nУже были: ' + skipped.join(', ') : '');
  Logger.log(msg);
  try { SpreadsheetApp.getUi().alert('3D Home Academy', msg, SpreadsheetApp.getUi().ButtonSet.OK); } catch (e) {}
}
