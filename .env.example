# Фронтенд (используются при сборке: npm run build)
# demo | google-sheets
VITE_CATALOG_SOURCE=demo
# Адрес адаптера Naidu.kz — оставить пустым, пока API не согласован
VITE_NAIDU_ENDPOINT=

# Сервер (npm start)
PORT=8080
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=
# GOOGLE_SERVICE_ACCOUNT_JSON=   (альтернатива файлу)
# GOOGLE_API_KEY=                (только для таблицы с открытым доступом по ссылке)
CATALOG_TTL_SECONDS=300
ADMIN_TOKEN=
